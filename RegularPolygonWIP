/*


Main method:
-prompt user to enter # of sides
-prompt user to enter side length
  *assume side length to be 3 or greater

Create a method:
-calculate the area using
  *area = (n*l*apothem)/2
  *apothem = (1/(2tan(180/n)))
  *l = side length
  *n = number of sides

Call the area calculation method in the main method


*/

import java.util.Scanner;
import java.lang.Math; // somehow made a wombo combo import?

class RegularPolyWIP {

   public static double calcRegPoAr(double n, double l){
      double apothem = l / (2 * Math.tan (Math.toRadians(180 / n)));
      return (n * l * apothem) / 2;
   }
  
   public static void main(String[] args){
      Scanner in = new Scanner(System.in);

      System.out.print("(Minimum = 3) Enter a number of sides: ");
      double n = in.nextDouble();
         if (n >= 3){
            System.out.println("(Minimum = 3) Enter a length for the legs: ");
            double l = in.nextDouble();
               if (l >= 3){
                  break;
               }else{
                  System.out.print("That isn't what we're looking for, try again!");
               }
         else{
            System.out.print("Not a number we want! Better luck next time!");
         }
         }
   }
}
