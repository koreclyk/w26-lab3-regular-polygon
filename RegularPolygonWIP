/*


Main method:
-prompt user to enter # of sides
-prompt user to enter side length
  *assume side length to be 3 or greater

Create a method:
-calculate the area using
  *area = (n*l*apothem)/2
  *apothem = (1/(2tan(180/n)))
  *l = side length
  *n = number of sides

Call the area calculation method in the main method


*/

import java.util.Scanner;
import java.lang.Math; // somehow made a wombo combo import?

class RegularPolyWIP {

   public static double calcRegPoAr(double n, double l){
      double apothem = l / (2 * Math.tan (Math.toRadians(180 / n)));
      return (n * l * apothem) / 2;
   }
  
